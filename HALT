<!DOCTYPE html>

<html lang="pl">

<head>

<meta charset="utf-8"/>

<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>

<title>HALT.xce — Dzienna Lista HALT</title>

<style>

  :root{

    --bg:#fafafa; --card:#ffffff; --ink:#1a1a1a; --muted:#6b6b6b; --accent:#2563eb;

    --ok:#0f766e; --bad:#b91c1c; --warn:#b45309; --line:#e5e7eb;

  }

  *{box-sizing:border-box}

  body{margin:0;font:16px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Inter,Arial,sans-serif;background:var(--bg);color:var(--ink)}

  header{position:sticky;top:0;background:var(--card);z-index:10;border-bottom:1px solid var(--line)}

  .wrap{max-width:960px;margin:0 auto;padding:12px 16px}

  h1{font-size:20px;margin:4px 0 2px}

  .sub{color:var(--muted);font-size:13px;margin:0 0 8px}

  .tabs{display:flex;gap:8px;flex-wrap:wrap;margin:8px 0}

  .tab-btn{appearance:none;border:1px solid var(--line);background:#fff;padding:8px 12px;border-radius:10px;cursor:pointer}

  .tab-btn[aria-current="true"]{border-color:var(--accent);color:#fff;background:var(--accent)}

  main{padding:12px 16px}

  .grid{display:grid;grid-template-columns:1fr;gap:12px}

  @media (min-width:760px){.grid{grid-template-columns:2fr 1fr}}

  .card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px}

  .category{font-weight:700;margin:12px 0 8px}

  .q{display:grid;grid-template-columns:1fr minmax(90px,120px);gap:8px;align-items:start;padding:10px;border:1px solid var(--line);border-radius:10px}

  .q + .q{margin-top:8px}

  .q label{display:block}

  select, textarea, input[type="text"]{width:100%;padding:8px;border:1px solid var(--line);border-radius:8px;font:inherit}

  textarea{min-height:56px;resize:vertical}

  .comment{grid-column:1 / -1}

  .row{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px;align-items:center}

  .pill{border:1px solid var(--line);border-radius:999px;padding:6px 10px;font-size:12px;color:var(--muted)}

  .ok{color:var(--ok)} .bad{color:var(--bad)} .warn{color:var(--warn)}

  .btn{appearance:none;border:1px solid var(--line);background:#fff;border-radius:10px;padding:10px 12px;cursor:pointer}

  .btn.primary{border-color:var(--accent);background:var(--accent);color:#fff}

  .muted{color:var(--muted)}

  .foot{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:8px}

  .summary-list{margin:0;padding-left:18px}

  .sticky-summary{position:sticky;top:68px}

  .notice{background:#fff8e1;border:1px solid #fde68a;padding:10px;border-radius:8px}

  .small{font-size:12px}

  .hidden{display:none}

  .spacer{flex:1}

</style>

</head>

<body>

<header>

  <div class="wrap">

    <h1>HALT.xce — codzienna lista kontrolna</h1>

    <p class="sub">HUNGRY • ANGRY • LONELY • TIRED (+ lęk, egoizm, uczciwość). Zapisuj odpowiedzi „Tak/Nie” i dopisuj komentarze. Wszystko zapisuje się w tej przeglądarce.</p>

    <nav class="tabs" role="tablist">

      <button class="tab-btn" data-tab="checklist" aria-current="true">Checklist</button>

      <button class="tab-btn" data-tab="summary">Podsumowanie</button>

      <button class="tab-btn" data-tab="instructions">Instrukcje</button>

    </nav>

  </div>

</header>

<main class="wrap">

  <div class="grid">

    <section id="checklist" class="card" role="tabpanel">

      <div id="questions"></div>

      <div class="foot">

        <button class="btn primary" id="copyReport">Kopiuj raport</button>

        <label class="small" style="display:flex;gap:6px;align-items:center">

          <input type="checkbox" id="clearAfterCopy"/>

          <span>Po skopiowaniu wyczyść odpowiedzi</span>

        </label>

        <span class="spacer"></span>

        <button class="btn" id="clearAll">Wyczyść wszystko</button>

        <button class="btn" id="printPage">Drukuj / PDF</button>

        <span class="muted small" id="autosaveInfo">Autozapis włączony • <span id="lastSaved">—</span></span>

      </div>

    </section>

    <aside id="liveSummary" class="card sticky-summary" aria-live="polite">

      <h3>Podsumowanie (na żywo)</h3>

      <div id="liveSummaryBody" class="muted small">Wpisz odpowiedzi, a tu pojawi się skrót.</div>

    </aside>

    <section id="summary" class="card hidden" role="tabpanel" aria-hidden="true">

      <h3>Pełne podsumowanie</h3>

      <div id="fullSummary"></div>

      <div class="row">

        <button class="btn primary" id="copySummary">Kopiuj podsumowanie</button>

        <label class="small" style="display:flex;gap:6px;align-items:center">

          <input type="checkbox" id="clearAfterCopy2"/>

          <span>Po skopiowaniu wyczyść odpowiedzi</span>

        </label>

        <span class="spacer"></span>

        <button class="btn" id="exportJSON">Eksportuj JSON</button>

        <input class="btn" type="file" id="importJSON" accept="application/json" title="Importuj zapisany plik JSON"/>

      </div>

    </section>

    <section id="instructions" class="card hidden" role="tabpanel" aria-hidden="true">

      <h3>Instrukcje</h3>

      <ol>

        <li>Przechodź po pytaniach i wybieraj <strong>Tak/Nie</strong>. Jeśli chcesz, dopisz komentarz.</li>

        <li>Wszystko zapisuje się <em>automatycznie</em> na tym urządzeniu.</li>

        <li>Użyj przycisku <em>Kopiuj raport</em>, aby wkleić wynik do notatek, wiadomości lub dziennika.</li>

        <li>W zakładce <em>Podsumowanie</em> możesz eksportować/importować dane w formacie JSON.</li>

        <li>Przycisk <em>Drukuj/PDF</em> pozwala zapisać całość jako PDF.</li>

      </ol>

      <div class="notice small"><strong>Uwaga prywatność:</strong> Dane nie opuszczają Twojego urządzenia, dopóki ich nie skopiujesz/wyeksportujesz.</div>

    </section>

  </div>

</main>

<script>

const QUESTIONS = [

  {cat:"HUNGRY", q:"Czy miałam dziś abstynencję wg planu jedzenia?"},

  {cat:"HUNGRY", q:"Czy miałam wpadkę/poślizg?"},

  {cat:"HUNGRY", q:"Czy opuszczałam posiłki i kombinowałam?"},

  {cat:"HUNGRY", q:"Czy dręczyły mnie myśli o jedzeniu?"},

  {cat:"HUNGRY", q:"Czy pracowałam nad sobą (czy podejmowałam działanie w kierunku zdrowienia)?"},

  {cat:"ANGRY", q:"Czy czułam złość (nie gniew)?"},

  {cat:"ANGRY", q:"Czy mam jakieś urazy?"},

  {cat:"ANGRY", q:"Czy byłam nieuprzejma?"},

  {cat:"LONELY", q:"Czy czułam się samotna?"},

  {cat:"LONELY", q:"Czy rozmawiałam z kimś ze wspólnoty, czy zadzwoniłam do kogoś, odebrałam telefon?"},

  {cat:"LONELY", q:"Czy byłam na mityngu?"},

  {cat:"LONELY", q:"Czy kontaktowałam się z SW (modlitwa/medytacja)?"},

  {cat:"TIRED", q:"Czy przemęczyłam się lub leniłam?"},

  {cat:"TIRED", q:"Czy odkładałam coś na później?"},

  {cat:"TIRED", q:"Czy poświęciłam odpowiednią ilość czasu na świadomy odpoczynek?"},

  {cat:"TIRED", q:"Czy wykonałam wszystkie najważniejsze rzeczy na dziś?"},

  {cat:"LĘK", q:"Czy bałam się czegoś?"},

  {cat:"LĘK", q:"Czy mój lęk był egocentryczny?"},

  {cat:"EGOIZM", q:"Czy użalałam się nad sobą?"},

  {cat:"EGOIZM", q:"Czy stawiałam granice i szanowałam siebie?"},

  {cat:"EGOIZM", q:"Czy zadbałam o siebie?"},

  {cat:"EGOIZM", q:"Czy zrobiłam coś dla innych?"},

  {cat:"UCZCIWOŚĆ", q:"Czy byłam uczciwa w pracy (np. przepracowałam co najmniej 6 h)?"},

  {cat:"UCZCIWOŚĆ", q:"Czy byłam uczciwa w domu (wykonałam obowiązki domowe)?"},

  {cat:"UCZCIWOŚĆ", q:"Czy wypełniłam zobowiązania: różańcowe/obiecane rzeczy?"}

];

const KEY = "HALT_XCE_GITHUB_V1";

function groupBy(arr, key) {

  return arr.reduce((acc, x) => ((acc[x[key]] ??= []).push(x), acc), {});

}

function loadState(){

  try {

    const raw = localStorage.getItem(KEY);

    if(!raw) return {};

    return JSON.parse(raw);

  } catch(e){ return {}; }

}

function saveState(){

  const data = serialize();

  localStorage.setItem(KEY, JSON.stringify(data));

  document.querySelector("#lastSaved").textContent = new Date().toLocaleString();

  renderLiveSummary();

}

function serialize(){

  const rows = [...document.querySelectorAll(".q")].map(el => {

    const id = +el.dataset.id;

    const val = el.querySelector("select").value;

    const comment = el.querySelector("textarea").value.trim();

    return {id, val, comment};

  });

  return { date: new Date().toISOString(), rows };

}

function buildQuestions(){

  const wrap = document.getElementById("questions");

  wrap.innerHTML = "";

  const byCat = groupBy(QUESTIONS.map((q,i)=>({id:i, ...q})),"cat");

  for(const cat of Object.keys(byCat)){

    const title = document.createElement("div");

    title.className = "category";

    title.textContent = cat;

    wrap.appendChild(title);

    byCat[cat].forEach(item => {

      const div = document.createElement("div");

      div.className = "q";

      div.dataset.id = item.id;

      const label = document.createElement("label");

      label.textContent = item.q;

      const select = document.createElement("select");

      ["","Tak","Nie"].forEach(v => {

        const opt = document.createElement("option");

        opt.value = v;

        opt.textContent = v===""?"—":v;

        select.appendChild(opt);

      });

      const comment = document.createElement("textarea");

      comment.placeholder = "Komentarz (opcjonalnie)";

      comment.className = "comment";

      select.addEventListener("change", saveState);

      comment.addEventListener("input", ()=>{

        clearTimeout(comment._t);

        comment._t = setTimeout(saveState, 400);

      });

      div.appendChild(label);

      div.appendChild(select);

      div.appendChild(comment);

      wrap.appendChild(div);

    });

  }

}

function restore(){

  const state = loadState();

  if(!state.rows) return;

  state.rows.forEach(r => {

    const node = document.querySelector('.q[data-id="' + r.id + '"]');

    if(!node) return;

    node.querySelector("select").value = r.val ?? "";

    node.querySelector("textarea").value = r.comment ?? "";

  });

  if(state.date){

    document.querySelector("#lastSaved").textContent = new Date(state.date).toLocaleString();

  }

}

function makeReport(){

  const data = serialize();

  const lines = [];

  lines.push("HALT.xce — raport z " + new Date().toLocaleString());

  const byCat = {};

  data.rows.forEach(r => {

    const q = QUESTIONS[r.id];

    (byCat[q.cat] ??= []).push({q:q.q, a:r.val||"—", c:r.comment});

  });

  for(const cat of Object.keys(byCat)){

    lines.push("");

    lines.push(cat.toUpperCase());

    byCat[cat].forEach(row=>{

      let line = "• " + row.q + " — " + row.a;

      if(row.c) line += " [" + row.c + "]";

      lines.push(line);

    });

  }

  const stats = getStats(data);

  lines.push("");

  lines.push("Suma: " + stats.answered + "/" + QUESTIONS.length + " odpowiedzi — Tak: " + stats.tak + ", Nie: " + stats.nie);

  lines.push("Czerwone flagi (pytania wrażliwe oznaczone „Nie”): " + (stats.flags.join("; ") || "brak"));

  return lines.join("\\n");

}

function getStats(data){

  const answered = data.rows.filter(r => r.val).length;

  const tak = data.rows.filter(r => r.val==="Tak").length;

  const nie = data.rows.filter(r => r.val==="Nie").length;

  const sensitiveIdx = [0,2,3,4,9,10,11,14,15,16,17,19,20,21,22,23,24];

  const flags = data.rows

    .filter(r => r.val==="Nie" && sensitiveIdx.includes(r.id))

    .map(r => QUESTIONS[r.id].q);

  return {answered,tak,nie,flags};

}

function renderLiveSummary(){

  const data = serialize();

  const stats = getStats(data);

  const byCat = groupBy(QUESTIONS.map((q,i)=>({id:i, ...q})),"cat");

  let html = '<div class="row">' +

      '<span class="pill">Pytania: ' + QUESTIONS.length + '</span>' +

      '<span class="pill">Uzupełnione: ' + stats.answered + '</span>' +

      '<span class="pill ok">Tak: ' + stats.tak + '</span>' +

      '<span class="pill bad">Nie: ' + stats.nie + '</span>' +

    '</div>';

  html += '<h4>Po kategoriach</h4>';

  html += '<ul class="summary-list">';

  for(const cat of Object.keys(byCat)){

    const ids = byCat[cat].map(x=>x.id);

    const catRows = data.rows.filter(r => ids.includes(r.id));

    const t = catRows.filter(r=>r.val==="Tak").length;

    const n = catRows.filter(r=>r.val==="Nie").length;

    html += '<li><strong>' + cat + '</strong>: Tak ' + t + ' • Nie ' + n + '</li>';

  }

  html += '</ul>';

  if(stats.flags.length){

    html += '<p class="bad small"><strong>Czerwone flagi:</strong> ' + stats.flags.length + '</p>';

  }

  document.querySelector("#liveSummaryBody").innerHTML = html;

}

function renderFullSummary(){

  const txt = makeReport().replaceAll("&","&amp;").replaceAll("<","&lt;");

  document.getElementById("fullSummary").innerHTML =

    '<pre class="small" style="white-space:pre-wrap">' + txt + '</pre>';

}

function clearAll(){

  document.querySelectorAll(".q").forEach(el=>{

    el.querySelector("select").value = "";

    el.querySelector("textarea").value = "";

  });

  localStorage.removeItem(KEY);

  document.querySelector("#lastSaved").textContent = "—";

  renderLiveSummary();

  if(document.querySelector("#summary").getAttribute("aria-hidden")==="false"){

    renderFullSummary();

  }

}

document.addEventListener("click", (e)=>{

  const b = e.target.closest(".tab-btn");

  if(!b) return;

  document.querySelectorAll(".tab-btn").forEach(x=>x.setAttribute("aria-current","false"));

  b.setAttribute("aria-current","true");

  const target = b.dataset.tab;

  document.querySelectorAll("[role=" + "'tabpanel'" + "]").forEach(p=>{

    const show = p.id===target;

    p.classList.toggle("hidden", !show);

    p.setAttribute("aria-hidden", show? "false":"true");

  });

  if(target==="summary"){ renderFullSummary(); }

});

document.getElementById("copyReport").addEventListener("click", async ()=>{

  const txt = makeReport();

  await navigator.clipboard.writeText(txt);

  const shouldClear = document.getElementById("clearAfterCopy").checked;

  if(shouldClear){

    clearAll();

    alert("Skopiowano raport do schowka i wyczyszczono odpowiedzi.");

  }else{

    alert("Skopiowano raport do schowka.");

  }

});

document.getElementById("copySummary").addEventListener("click", async ()=>{

  const txt = makeReport();

  await navigator.clipboard.writeText(txt);

  const shouldClear = document.getElementById("clearAfterCopy2").checked;

  if(shouldClear){

    clearAll();

    alert("Podsumowanie skopiowane. Odpowiedzi wyczyszczone.");

  }else{

    alert("Podsumowanie skopiowane.");

  }

});

document.getElementById("printPage").addEventListener("click", ()=>{ window.print(); });

document.getElementById("clearAll").addEventListener("click", ()=>{

  if(confirm("Na pewno wyczyścić wszystkie odpowiedzi i komentarze? Tego nie da się cofnąć.")){

    clearAll();

  }

});

document.getElementById("exportJSON").addEventListener("click", ()=>{

  const data = serialize();

  const blob = new Blob([JSON.stringify(data,null,2)], {type:"application/json"});

  const a = document.createElement("a");

  a.href = URL.createObjectURL(blob);

  a.download = "HALT_xce_" + new Date().toISOString().slice(0,10) + ".json";

  a.click();

});

document.getElementById("importJSON").addEventListener("change", async (e)=>{

  const file = e.target.files[0]; if(!file) return;

  const text = await file.text();

  try{

    const data = JSON.parse(text);

    if(!Array.isArray(data.rows)) throw new Error("Niepoprawny format.");

    localStorage.setItem(KEY, JSON.stringify(data));

    restore();

    renderLiveSummary();

    renderFullSummary();

    alert("Zaimportowano dane.");

  }catch(err){

    alert("Błąd importu: " + err.message);

  }

});

buildQuestions();

restore();

renderLiveSummary();

</script>

</body>

</html>